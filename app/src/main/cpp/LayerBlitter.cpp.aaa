    count += 1.0;
  }
  if (colorDistance(c4, candidate) < similarityThreshold) {
    sum += c4;
    count += 1.0;
  }
  if (colorDistance(c5, candidate) < similarityThreshold) {
    sum += c5;
    count += 1.0;
  }
  if (colorDistance(c6, candidate) < similarityThreshold) {
    sum += c6;
    count += 1.0;
