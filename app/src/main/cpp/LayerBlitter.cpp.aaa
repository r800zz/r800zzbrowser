      float(colorDistance(c7, c6) < similarityThreshold);

  vec3 candidate = c0;
  float bestScore = s0;

  if (s1 > bestScore) { candidate = c1; bestScore = s1; }
  if (s2 > bestScore) { candidate = c2; bestScore = s2; }
  if (s3 > bestScore) { candidate = c3; bestScore = s3; }
  if (s4 > bestScore) { candidate = c4; bestScore = s4; }
  if (s5 > bestScore) { candidate = c5; bestScore = s5; }
